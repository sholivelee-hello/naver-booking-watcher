<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS LaunchAgent: 네이버 예약 빈자리 감시기를 24시간 백그라운드 실행.
  설치 경로의 절대 경로(/Users/olive/...)를 본인 환경에 맞게 수정 후
  ~/Library/LaunchAgents/ 로 복사하고 launchctl load 한다.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hospital.naver-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/olive/projects/hospital/deploy/run-local.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/olive/projects/hospital</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/olive/projects/hospital/logs/watcher.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/olive/projects/hospital/logs/watcher.log</string>
</dict>
</plist>
